# Copy this file to .env and add a Gemini API key from Google AI Studio.
# Without a key the app runs in clearly labeled Demo Mode (not live AI).

FLASK_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///compatibilitymatch.db

# Admin account created once on first launch. Set a private strong password locally.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Gemini API through Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite

# Optional cost estimate (USD per 1M tokens). Used only for monitoring display.
LLM_INPUT_COST_PER_1M=0.30
LLM_OUTPUT_COST_PER_1M=2.50
LLM_TIMEOUT_SECONDS=25
LLM_RETRY_ATTEMPTS=2

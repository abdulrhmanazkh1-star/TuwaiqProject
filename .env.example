# Copy this file to .env and fill in values if you have an LLM API key.
# Without a key the app runs in labeled Demo Mode (deterministic rules, not live AI).

FLASK_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///compatibilitymatch.db

# OpenAI-compatible LLM. Leave LLM_API_KEY empty for Demo Mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional cost estimate (USD per 1M tokens). Used only for monitoring display.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60
